{% trans_default_domain 'pactum' %}
<table class="tl_listing showColumns">
    <thead>
        <tr>
            <th class="tl_folder_tlist">{{ 'be.audit.time'|trans }}</th>
            <th class="tl_folder_tlist">{{ 'be.audit.event'|trans }}</th>
            <th class="tl_folder_tlist">{{ 'be.audit.actor'|trans }}</th>
            <th class="tl_folder_tlist">{{ 'be.audit.context'|trans }}</th>
        </tr>
    </thead>
    <tbody>
        {% for entry in entries %}
            <tr class="hover-row">
                <td class="tl_file_list">{{ entry.created_at|date('d.m.Y H:i:s') }}</td>
                <td class="tl_file_list">{{ ('audit_event.' ~ entry.event)|trans }}</td>
                <td class="tl_file_list">{{ entry.actor }}</td>
                <td class="tl_file_list"><code>{{ entry.context|json_encode }}</code></td>
            </tr>
        {% else %}
            <tr><td colspan="4" class="tl_file_list">{{ 'be.audit.empty'|trans }}</td></tr>
        {% endfor %}
    </tbody>
</table>
