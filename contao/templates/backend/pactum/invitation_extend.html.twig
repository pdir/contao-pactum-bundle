{% extends '@Contao/backend/pactum/_layout.html.twig' %}
{% trans_default_domain 'pactum' %}

{% block pactum_content %}
    {% if action_error %}
        <p class="tl_error">{{ action_error }}</p>
    {% endif %}
    <form method="post" class="tl_form">
        <div class="tl_formbody_edit">
            <input type="hidden" name="REQUEST_TOKEN" value="{{ contao.request_token }}">
            <p>{{ 'be.invitation.current_expiry'|trans({'%date%': invitation.expiresAt|date('d.m.Y')}) }}</p>
            <div class="widget">
                <h3><label for="pactum-days">{{ 'be.invitation.extend_days'|trans }}</label></h3>
                <input id="pactum-days" type="number" min="1" max="3650" name="days" class="tl_text" value="{{ default_days }}" required>
            </div>
        </div>
        <div class="tl_formbody_submit">
            <div class="tl_submit_container">
                <button type="submit" class="tl_submit">{{ 'be.invitation.extend_submit'|trans }}</button>
                <a href="{{ back_url }}" class="tl_submit">{{ 'be.cancel'|trans }}</a>
            </div>
        </div>
    </form>
{% endblock %}
