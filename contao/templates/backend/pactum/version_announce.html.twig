{% extends '@Contao/backend/pactum/_layout.html.twig' %}
{% trans_default_domain 'pactum' %}

{% block pactum_content %}
    {% if announce_error %}
        <p class="tl_error">{{ announce_error }}</p>
    {% endif %}
    {% if announcement_preview is not null %}
        {% set p = announcement_preview %}
        <form method="post" class="tl_form">
            <div class="tl_formbody_edit">
                <input type="hidden" name="REQUEST_TOKEN" value="{{ contao.request_token }}">
                <p class="tl_confirm">{{ 'be.announcement.question'|trans({'%template%': p.template.title, '%language%': p.draft.language, '%active%': p.activeVersion.versionNumber, '%draft%': p.draft.versionNumber}) }}</p>
                <table class="tl_listing">
                    <thead>
                        <tr>
                            <th class="tl_folder_tlist">{{ 'announcement.change'|trans }}</th>
                            <th class="tl_folder_tlist">{{ 'annex.subprocessor.name'|trans }}</th>
                            <th class="tl_folder_tlist">{{ 'annex.subprocessor.service'|trans }}</th>
                            <th class="tl_folder_tlist">{{ 'annex.subprocessor.location'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for type, list in {added: p.changes.added, changed: p.changes.changed, removed: p.changes.removed} %}
                            {% for sub in list %}
                                <tr>
                                    <td class="tl_file_list">{{ ('announcement.change.' ~ type)|trans }}</td>
                                    <td class="tl_file_list"><strong>{{ sub.name }}</strong><br>{{ sub.address|nl2br }}</td>
                                    <td class="tl_file_list">{{ sub.service|nl2br }}</td>
                                    <td class="tl_file_list">{{ ('annex.location.' ~ sub.location)|trans }}{% if sub.thirdCountry and sub.transferBasis %}<br>{{ sub.transferBasis }}{% endif %}</td>
                                </tr>
                            {% endfor %}
                        {% endfor %}
                    </tbody>
                </table>
                <p class="tl_help">{{ 'be.announcement.summary'|trans({'%count%': p.recipients|length, '%days%': p.noticeDays, '%date%': p.effectiveAt|date('d.m.Y')}) }}</p>
                <p class="tl_help">{{ 'be.announcement.hint'|trans }}</p>
            </div>
            {% if not announce_error %}
                <div class="tl_formbody_submit">
                    <div class="tl_submit_container">
                        <button type="submit" class="tl_submit">{{ 'be.announcement.submit'|trans({'%count%': p.recipients|length}) }}</button>
                        <a href="{{ back_url }}" class="tl_submit">{{ 'be.cancel'|trans }}</a>
                    </div>
                </div>
            {% endif %}
        </form>
    {% else %}
        <p><a href="{{ back_url }}" class="tl_submit">{{ 'be.back'|trans }}</a></p>
    {% endif %}
{% endblock %}
