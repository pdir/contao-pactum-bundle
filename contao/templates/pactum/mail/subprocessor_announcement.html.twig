{% extends '@Contao/pactum/mail/_layout.html.twig' %}
{% trans_default_domain 'pactum' %}
{% block content %}
    <p>{{ signatory_name ? 'mail.greeting_name'|trans({'%name%': signatory_name}, 'pactum', locale) : 'mail.greeting'|trans({}, 'pactum', locale) }}</p>
    <p>{{ 'mail.subprocessor_announcement.text'|trans({'%contractor%': contractor.name, '%contract%': template_title, '%company%': company}, 'pactum', locale) }}</p>
    <table style="width:100%;border-collapse:collapse;font-size:14px;margin:16px 0;">
        {% for type, list in {added: changes.added, changed: changes.changed, removed: changes.removed} %}
            {% for sub in list %}
                <tr>
                    <td style="border:1px solid #dddddd;padding:8px;vertical-align:top;white-space:nowrap;">{{ ('announcement.change.' ~ type)|trans({}, 'pactum', locale) }}</td>
                    <td style="border:1px solid #dddddd;padding:8px;vertical-align:top;"><strong>{{ sub.name }}</strong><br>{{ sub.address|nl2br }}</td>
                    <td style="border:1px solid #dddddd;padding:8px;vertical-align:top;">{{ sub.service|nl2br }}<br>{{ ('annex.location.' ~ sub.location)|trans({}, 'pactum', locale) }}{% if sub.thirdCountry and sub.transferBasis %} ({{ sub.transferBasis }}){% endif %}</td>
                </tr>
            {% endfor %}
        {% endfor %}
    </table>
    <p>{{ 'mail.subprocessor_announcement.objection'|trans({'%date%': effective_at|date('d.m.Y'), '%days%': notice_days}, 'pactum', locale) }}</p>
    <p><a href="{{ url }}" style="display:inline-block;padding:12px 20px;background:#1f1f1f;color:#ffffff;text-decoration:none;">{{ 'mail.subprocessor_announcement.button'|trans({}, 'pactum', locale) }}</a></p>
    <p>{{ 'mail.subprocessor_announcement.deemed_approved'|trans({'%date%': effective_at|date('d.m.Y')}, 'pactum', locale) }}</p>
    <p>{{ 'mail.closing'|trans({'%contractor%': contractor.name}, 'pactum', locale) }}</p>
{% endblock %}
