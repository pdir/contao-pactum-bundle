{% extends '@Contao/pactum/mail/_layout.html.twig' %}
{% trans_default_domain 'pactum' %}
{% block content %}
    <p>{{ 'mail.greeting'|trans({}, 'pactum', locale) }}</p>
    <p>{{ 'mail.invitation.text'|trans({'%contractor%': contractor.name, '%contract%': template_title}, 'pactum', locale) }}</p>
    <p><a href="{{ url }}" style="display:inline-block;padding:12px 20px;background:#1f1f1f;color:#ffffff;text-decoration:none;">{{ 'mail.invitation.button'|trans({}, 'pactum', locale) }}</a></p>
    <p style="font-size:13px;color:#666666;">{{ 'mail.invitation.expiry'|trans({'%date%': expires_at|date('d.m.Y')}, 'pactum', locale) }}</p>
    <p>{{ 'mail.closing'|trans({'%contractor%': contractor.name}, 'pactum', locale) }}</p>
{% endblock %}
