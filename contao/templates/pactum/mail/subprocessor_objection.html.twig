{% extends '@Contao/pactum/mail/_layout.html.twig' %}
{% trans_default_domain 'pactum' %}
{% block content %}
    <p>{{ 'mail.subprocessor_objection.text'|trans({'%company%': company, '%contract%': template_title}, 'pactum', locale) }}</p>
    <table style="width:100%;border-collapse:collapse;font-size:14px;margin:16px 0;">
        <tr><td style="padding:4px 8px 4px 0;vertical-align:top;color:#666666;">{{ 'mail.subprocessor_objection.company'|trans({}, 'pactum', locale) }}</td><td style="padding:4px 0;">{{ company }}</td></tr>
        <tr><td style="padding:4px 8px 4px 0;vertical-align:top;color:#666666;">{{ 'mail.subprocessor_objection.name'|trans({}, 'pactum', locale) }}</td><td style="padding:4px 0;">{{ objection_name }} ({{ email }})</td></tr>
        <tr><td style="padding:4px 8px 4px 0;vertical-align:top;color:#666666;">{{ 'mail.subprocessor_objection.subprocessors'|trans({}, 'pactum', locale) }}</td><td style="padding:4px 0;">{{ subprocessors|join(', ') }}</td></tr>
        <tr><td style="padding:4px 8px 4px 0;vertical-align:top;color:#666666;">{{ 'mail.subprocessor_objection.date'|trans({}, 'pactum', locale) }}</td><td style="padding:4px 0;">{{ objected_at|date('d.m.Y H:i') }}</td></tr>
    </table>
    <p><strong>{{ 'mail.subprocessor_objection.reason'|trans({}, 'pactum', locale) }}</strong></p>
    <p style="white-space:pre-line;">{{ reason }}</p>
    <p style="font-size:13px;color:#666666;">{{ 'mail.subprocessor_objection.hint'|trans({}, 'pactum', locale) }}</p>
{% endblock %}
